# Twelve environment. Copy to .env and fill in. Never commit .env (I11).

# All *_URL values must be full URLs with scheme and path (e.g. https://arc-mainnet.infura.io/v3/<PROJECT_ID>).
# Arc mainnet (chainId 5042) JSON-RPC over HTTPS. Public endpoint is permissioned — use a provider (e.g. QuickNode).
ARC_RPC_URL=
# Arc mainnet WebSocket endpoint (monitor head-following).
ARC_WS_URL=
# Arc testnet (chainId 5042002) JSON-RPC over HTTPS. Phase 0 used https://arc-testnet.drpc.org (free: 101-block getLogs span).
ARC_TESTNET_RPC_URL=
# Blockscout Pro API key — verified source via https://api.blockscout.com/5042/api/v2/...
BLOCKSCOUT_API_KEY=
# Postgres connection string (infra/compose.yml default shown).
DATABASE_URL=postgres://twelve:twelve@localhost:5432/twelve
# Attester hot key: small USDC balance, attest/revoke only. MUST differ from DEPLOYER_PRIVATE_KEY (I12).
ATTESTER_PRIVATE_KEY=
# Deployer key: loaded only by forge scripts, never by services (I12).
DEPLOYER_PRIVATE_KEY=
# TwelveRegistry address from deployment.
REGISTRY_ADDRESS=
# TwelveGate address from deployment.
GATE_ADDRESS=
# HMAC secret for signing webhook alert deliveries.
ALERT_WEBHOOK_SECRET=
# Optional: Telegram bot token for ops/alert delivery.
TELEGRAM_BOT_TOKEN=
# Blockscout verifier URL used by `forge script --verify --verifier blockscout`.
BLOCKSCOUT_VERIFY_URL=
# --- apps/api ---
# Attester refuses to attest below this native balance, in USDC (decimal string). Ops alert when hit.
ATTESTER_MIN_BALANCE=0.05
# Bearer token for POST /v1/admin/revoke (>= 16 chars). Leave empty to disable the admin route.
ADMIN_TOKEN=
# HTTP port for the API.
API_PORT=8787
# How the API invokes the analyzer CLI, and from which directory (repo root).
ANALYZER_CMD=uv run --project analyzer twelve
ANALYZER_CWD=../..
# Scan submissions per IP per minute.
SCAN_RATE_PER_MIN=10
# Tests only: admin connection used to create throwaway databases.
TEST_PG_ADMIN_URL=postgres://twelve:twelve@localhost:5432/postgres
# --- apps/monitor ---
# Which chain this monitor process follows: 5042 (mainnet) or 5042002 (testnet). Run one process per chain.
MONITOR_CHAIN_ID=5042
# Twelve's attester PUBLIC address (the monitor holds no key; D4 revokes go through the API admin route).
ATTESTER_ADDRESS=
# API base URL the monitor calls for D4 revoke + rescan (with ADMIN_TOKEN).
API_URL=http://localhost:8787
# First block to ingest; omit for genesis (exact balances; D3/BALANCE need complete history). Keep stable per database.
MONITOR_START_BLOCK=
# Max blocks per eth_getLogs window (Infura caps at 10,000; result-size splits are automatic).
MONITOR_WINDOW=10000
# Head polling interval in ms (no WS endpoint configured; MONITOR §1 polling fallback).
MONITOR_POLL_MS=400
# Optional Telegram chat for HIGH/OPS alerts (with TELEGRAM_BOT_TOKEN above).
TELEGRAM_CHAT_ID=
# Addresses the public alert feed may name (ADR-022): our own deployments + resolved disclosures. Comma-separated.
# Mainnet: LeakyRefund, gate targets (FINDINGS, CLEAN), registry, gate. Testnet: LeakyRefund, demo proxy v1.
DISCLOSED_ADDRESSES=0xA6c15eDC8ceffb558A54ead5bd9d833A589276bC,0x5A76D4AB409CA2114808eDD38cB9A8343a34b7Fb,0x42957B36F5623912dED1a0A16bba3dad22E571C9,0x6670030e9df18e3A454eA77d69D00Fd8d17728A1,0x7a63d663861f84cd0F6F66DE29945620C1Cc95b7,0x3DBE97Cf796e313Be59B61E836488203Cb5CBe07,0x63Dbb10EA994AAc43D1E94d5429B4f28DfFC8BDa
# --- apps/api ↔ apps/web ---
# Comma-separated browser origins allowed to call the API (CORS).
WEB_ORIGIN=http://localhost:3000
# --- apps/web ---
# Public base URL of the API, used by the browser (live alerts, scans).
NEXT_PUBLIC_API_URL=http://localhost:8787
